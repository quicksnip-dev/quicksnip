{
  "title": "Binary Search",
  "description": "Searches for an element in a sorted array using the Binary Search algorithm.",
  "tags": [
    "search",
    "binarysearch",
    "array",
    "algorithm"
  ],
  "contributors": [
    "0xHouss"
  ],
  "usage": {
    "c": [
      "int arr[] = {2, 3, 4, 10, 40};",
      "int n = sizeof(arr) / sizeof(arr[0]);",
      "int x = 10;",
      "int result = binarySearch(arr, 0, n - 1, x);",
      "// result = 3 (index of the element 10)"
    ]
  }
}
