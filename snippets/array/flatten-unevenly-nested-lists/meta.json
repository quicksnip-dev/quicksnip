{
  "title": "Flatten Unevenly Nested Lists",
  "description": "Converts unevenly nested lists of any depth into a single flat list.",
  "tags": [
    "list",
    "flattening",
    "nested-lists",
    "depth"
  ],
  "contributors": [
    "agilarasu"
  ],
  "usage": {
    "py": [
      "nested_list = [1, [2, [3, 4]], 5]",
      "list(flatten(nested_list))  # Returns: [1, 2, 3, 4, 5]"
    ]
  }
}
