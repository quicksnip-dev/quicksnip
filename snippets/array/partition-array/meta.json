{
  "title": "Partition Array",
  "description": "Splits an array into two arrays based on a callback function.",
  "tags": [
    "array",
    "partition",
    "reduce"
  ],
  "contributors": [
    "Swaraj-Singh-30"
  ],
  "usage": {
    "js": [
      "const numbers = [1, 2, 3, 4, 5, 6];",
      "const isEven = (n) => n % 2 === 0;",
      "partition(numbers, isEven); // Returns: [[2, 4, 6], [1, 3, 5]]"
    ]
  }
}
