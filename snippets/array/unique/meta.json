  "usage": {
    "ts": [
      "unique([3, 1, 3, 2]);   // [3, 1, 2]",
      "unique(users, \"id\");    // first user per id",
      "unique(words, (w) => w.toLowerCase());"
    ],
    "cpp": [
      "std::vector<int> vec = {4, 2, 2, 8, 5, 6, 9, 9, 9, 8, 8, 4};",
      "removeDuplicates(vec); // returns {2, 4, 5, 6, 8, 9}"
