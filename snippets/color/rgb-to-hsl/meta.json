  "tags": [
    "color",
    "conversion"
  ],
  "contributors": [
    "pvictordev"
  ],
  "usage": {
    "js": [
      "console.log(rgbToHsl(255, 87, 51)); // { h: 14, s: 100, l: 60 }",
