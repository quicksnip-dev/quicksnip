{
  "title": "Insert Data into Sqlite Table",
  "description": "Inserts a row into a specified SQLite table using a dictionary of fields and values.",
  "tags": [
    "sqlite",
    "database"
  ],
  "contributors": [
    "e3nviction"
  ],
  "usage": {
    "py": [
      "db_path = 'example.db'",
      "table_name = 'users'",
      "data = {",
      "    'name': 'John Doe',",
      "    'email': 'john@example.com',",
      "    'age': 30",
      "}",
      "insert_into_table(db_path, table_name, data)"
    ]
  }
}
