  "description": "Converts any string (spaces, kebab, snake, Pascal) to camelCase.",
  "tags": [
    "string",
    "case",
    "camelcase"
  ],
  "contributors": [
    "aumirza",
    "Mcbencrafter"
  ],
  "usage": {
    "ts": [
      "camelCase(\"hello-world\");    // \"helloWorld\"",
