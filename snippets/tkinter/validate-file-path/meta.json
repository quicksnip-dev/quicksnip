{
  "title": "Validate File Path",
  "description": "A validation function to ensure the file path exists.",
  "tags": [
    "validation",
    "filepath",
    "fp"
  ],
  "contributors": [
    "Legopitstop"
  ],
  "usage": {
    "py": [
      "root = Tk()",
      "root.geometry(\"200x200\")",
      "",
      "reg = root.register(validate_file_path)",
      "Entry(root, validate=\"key\", validatecommand=(reg, \"%d\", \"%P\")).pack()",
      "",
      "root.mainloop()"
    ]
  }
}
