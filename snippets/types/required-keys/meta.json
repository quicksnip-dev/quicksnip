{
  "title": "Required Keys",
  "description": "Extracts required keys from an object.",
  "tags": [
    "helper-types",
    "typedefinition",
    "required"
  ],
  "contributors": [
    "aelshinawy"
  ],
  "usage": {
    "ts": [
      "type A = {",
      "    id: string;",
      "    name?: string;",
      "    isActive: boolean;",
      "};",
      "",
      "type ReqKeys = RequiredKeys<A>; // \"id\" | \"isActive\""
    ]
  }
}
